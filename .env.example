# Copy to .env for local development. Never commit .env.
# Everything here is optional except the model path for AI tests.

# --- Local AI (llama.cpp) ---
# Absolute path to a GGUF model file.
GEOMIND_AI_MODEL_PATH=
# Required; the companion refuses to launch a model whose hash does not match.
GEOMIND_AI_MODEL_SHA256=
# How to invoke llama-server: an absolute path, or a command name on PATH.
GEOMIND_AI_SERVER_BIN=llama-server
GEOMIND_AI_CONTEXT_TOKENS=4096

# --- Companion ---
# One of: debug, info, warn, error. No request destinations are ever logged.
GEOMIND_LOG_LEVEL=warn
# Chrome starts the native host without arguments, so these are flag defaults.
GEOMIND_POLICY=
GEOMIND_KNOWN_EXITS=
GEOMIND_EXIT_ID=

# --- Test tunnel peer (test suites only; never real keys) ---
GEOMIND_TEST_WG_PRIVATE_KEY=
GEOMIND_TEST_WG_PEER_PUBLIC_KEY=
GEOMIND_TEST_WG_ENDPOINT=
GEOMIND_TEST_WG_ALLOWED_IPS=0.0.0.0/0,::/0

# --- WireGuard tunnel (Phase 1 test peer; keys are read from the environment) ---
# 64 hex characters each (32 raw bytes). Keys stay in memory; nothing is written to disk.
GEOMIND_WG_PRIVATE_KEY=
GEOMIND_WG_PEER_PUBLIC_KEY=
# IP:port literal. Hostnames are rejected so the endpoint is never resolved locally.
GEOMIND_WG_ENDPOINT=
# Address assigned to the tunnel interface, comma-separated for v4/v6.
GEOMIND_WG_LOCAL_ADDRS=
# CIDRs routed into the tunnel.
GEOMIND_WG_ALLOWED_IPS=
# DoH endpoint; must be an https URL whose host is an IP literal.
GEOMIND_WG_DOH=
GEOMIND_WG_MTU=1420
GEOMIND_WG_KEEPALIVE=25

# --- Exit metadata (later phases; used for locale consistency tests) ---
GEOMIND_EXIT_REGION=
GEOMIND_EXIT_TIMEZONE=
GEOMIND_EXIT_LOCALE=
GEOMIND_EXIT_DOH_URL=

# --- Remote session control plane (Phase 2 skeleton; dev only) ---
# Listens on loopback by default. A dev bearer token is required; use at least
# 16 printable characters. Never reuse this token outside local development.
GEOMIND_SESSION_ADDR=127.0.0.1:8080
GEOMIND_SESSION_DEV_TOKEN=
GEOMIND_SESSION_DEV_USER=dev
GEOMIND_SESSION_REGIONS=de-test
# Set to 1 only to bind a non-loopback address behind TLS.
GEOMIND_SESSION_ALLOW_PUBLIC=0
GEOMIND_SESSION_MAX_PER_USER=2
GEOMIND_SESSION_MAX_TOTAL=20
GEOMIND_SESSION_TTL=30m
GEOMIND_SESSION_IDLE=5m
GEOMIND_SESSION_USER_RATE=30
GEOMIND_SESSION_IP_RATE=120
# How long a synchronous create may spend provisioning before it is abandoned.
# Defaults to 2m, or the Kubernetes ready timeout plus 30s.
GEOMIND_SESSION_CREATE_TIMEOUT=

# --- Session runtime: fake (default) or kube ---
# The fake runtime creates no workloads. The Kubernetes runtime provisions one
# Pod, one Secret, and one NetworkPolicy per session and needs RBAC for those.
GEOMIND_SESSION_RUNTIME=fake
GEOMIND_SESSION_KUBE_NAMESPACE=geomind-sessions
# Image for the ephemeral browser/streaming Pod. Required when runtime=kube.
GEOMIND_SESSION_KUBE_IMAGE=
# Path to a kubeconfig. Leave empty for in-cluster credentials.
GEOMIND_SESSION_KUBECONFIG=
# Namespaces that hold the egress proxy and the streaming edge.
GEOMIND_SESSION_KUBE_PROXY_NAMESPACE=
GEOMIND_SESSION_KUBE_EDGE_NAMESPACE=
GEOMIND_SESSION_KUBE_PROXY_PORT=1080
GEOMIND_SESSION_KUBE_READY_TIMEOUT=2m
GEOMIND_SESSION_KUBE_POLL_INTERVAL=1s
