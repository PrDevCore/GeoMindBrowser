# GEMINI_API_KEY: Required for the AI copilot (POST /api/gemini/generate).
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
# Running locally: copy this file to .env and paste a real key from
# https://aistudio.google.com/apikey - a placeholder value here will not work.
# With an empty key the server still starts; the copilot replies that AI is not configured.
GEMINI_API_KEY=""

# GEMINI_MODEL: Optional Gemini model id used by the copilot.
# Defaults to gemini-3.8-flash when unset.
# GEMINI_MODEL="gemini-3.8-flash"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"
